{
  "name": "bepago",
  "version": "1.6.5",
  "description": "SDK oficial de bePago para Node.js (18+, sin dependencias, con tipos TypeScript; import o require)",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "index.d.cts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "bepago",
    "pagos",
    "payments",
    "paraguay",
    "cobros",
    "payouts",
    "webhooks"
  ],
  "homepage": "https://bepago.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bepago/sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/bepago/sdk-node/issues"
  },
  "engines": { "node": ">=18" },
  "author": "bePago",
  "license": "MIT"
}
